@model ConfigurationReader.Core.Entities.Configuration

@{
    ViewData["Title"] = "Delete Configuration";
}

<div class="container fade-in">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-danger text-white">
                    <h3 class="card-title mb-0">Delete Configuration</h3>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle"></i>
                        Are you sure you want to delete this configuration?
                    </div>

                    <dl class="row">
                        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Name)</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(model => model.Name)</dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Type)</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(model => model.Type)</dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Value)</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(model => model.Value)</dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ApplicationName)</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(model => model.ApplicationName)</dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.IsActive)</dt>
                        <dd class="col-sm-9">
                            <span class="badge @(Model.IsActive ? "bg-success" : "bg-danger")">
                                @(Model.IsActive ? "Active" : "Inactive")
                            </span>
                        </dd>
                    </dl>

                    <form asp-action="Delete" class="mt-4">
                        <input type="hidden" asp-for="Id" />
                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-trash"></i> Delete
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Back to List
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Add animation to form elements
            $('.card').addClass('fade-in');
        });
    </script>
} 